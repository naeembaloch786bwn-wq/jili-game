<!DOCTYPE html>
<html lang="ur">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - 3PattiPro</title>
    <script src="https://www.gstatic.com/firebasejs/9.17.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.17.1/firebase-database-compat.js"></script>
    <style>
        body { font-family: Arial, sans-serif; background: #f4f4f4; padding: 10px; direction: rtl; }
        .container { background: white; border-radius: 8px; padding: 15px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        h2 { color: #007bff; border-bottom: 2px solid #007bff; padding-bottom: 5px; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; background: #fff; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: center; font-size: 14px; }
        th { background-color: #007bff; color: white; }
        .btn-approve { background: #28a745; color: white; border: none; padding: 5px 10px; cursor: pointer; border-radius: 4px; }
        .btn-reject { background: #dc3545; color: white; border: none; padding: 5px 10px; cursor: pointer; border-radius: 4px; }
    </style>
</head>
<body>

<div class="container">
    <h2>Naye Khiladi (New Players)</h2>
    <table id="playersTable">
        <thead>
            <tr>
                <th>Naam</th>
                <th>Email/Phone</th>
                <th>Balance</th>
                <th>Join Date</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>

    <h2>Deposit Requests</h2>
    <table id="depositTable">
        <thead>
            <tr>
                <th>Player ID</th>
                <th>Amount</th>
                <th>Method</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>

    <h2>Withdrawal Requests</h2>
    <table id="withdrawalTable">
        <thead>
            <tr>
                <th>Player ID</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<script>
    // Aapke Firebase ki configuration
    const firebaseConfig = {
        apiKey: "AIzaSyDTNneivrTLe-s-e0lKW1fUixVSjDfu2k",
        authDomain: "pattipro-c1ffe.firebaseapp.com",
        databaseURL: "https://pattipro-c1ffe-default-rtdb.firebaseio.com",
        projectId: "pattipro-c1ffe",
        storageBucket: "pattipro-c1ffe.appspot.com",
        messagingSenderId: "766843054614",
        appId: "1:766843054614:web:781658832e63e41fc2e337"
    };

    firebase.initializeApp(firebaseConfig);
    const db = firebase.database();

    // 1. Players Data Load Karein
    db.ref('users').on('value', (snapshot) => {
        const tbody = document.querySelector('#playersTable tbody');
        tbody.innerHTML = '';
        snapshot.forEach((child) => {
            const user = child.val();
            tbody.innerHTML += `<tr>
                <td>${user.name || 'N/A'}</td>
                <td>${user.email || user.phone}</td>
                <td>Rs. ${user.balance || 0}</td>
                <td>${user.joinDate || '-'}</td>
            </tr>`;
        });
    });

    // 2. Deposit Requests Load Karein
    db.ref('deposits').on('value', (snapshot) => {
        const tbody = document.querySelector('#depositTable tbody');
        tbody.innerHTML = '';
        snapshot.forEach((child) => {
            const data = child.val();
            tbody.innerHTML += `<tr>
                <td>${data.userId}</td>
                <td>${data.amount}</td>
                <td>${data.method}</td>
                <td>
                    <button class="btn-approve" onclick="updateStatus('deposits', '${child.key}', 'Approved')">OK</button>
                </td>
            </tr>`;
        });
    });

    // 3. Withdrawal Requests Load Karein
    db.ref('withdrawals').on('value', (snapshot) => {
        const tbody = document.querySelector('#withdrawalTable tbody');
        tbody.innerHTML = '';
        snapshot.forEach((child) => {
            const data = child.val();
            tbody.innerHTML += `<tr>
                <td>${data.userId}</td>
                <td>${data.amount}</td>
                <td>${data.status}</td>
                <td>
                    <button class="btn-approve" onclick="updateStatus('withdrawals', '${child.key}', 'Paid')">Paid</button>
                    <button class="btn-reject" onclick="updateStatus('withdrawals', '${child.key}', 'Rejected')">X</button>
                </td>
            </tr>`;
        });
    });

    function updateStatus(path, id, status) {
        db.ref(path + '/' + id).update({ status: status })
        .then(() => alert("Status Updated!"));
    }
</script>

</body>
</html>
